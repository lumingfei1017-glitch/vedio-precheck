# ---------------------------------------------------------------------------
# video-precheck 环境变量示例
# 用法：cp .env.example .env，然后按需填写。真实 .env 已在 .gitignore 中。
# 所有值都会作为默认值，已存在的系统环境变量优先，不会被覆盖。
# ---------------------------------------------------------------------------

# --------------------------- 基础路径 ---------------------------
# 数据根目录（上传、stems 缓存、音色缓存、SQLite 都在这里），默认 ./data
# VIDEO_PRECHECK_DATA_DIR=
# SQLite 路径，默认 ./data/app.db
# VIDEO_PRECHECK_DB=
# 人声/BGM 分离产物目录，默认 ./data/stems
# VIDEO_PRECHECK_STEMS_DIR=

# FFmpeg / FFprobe。不填会自动从 PATH 里找。
# FFMPEG_PATH=D:\Users\AppData\Local\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=

# --------------------------- DashScope / ASR ---------------------------
# 必填：DashScope API Key
DASHSCOPE_API_KEY=
# OpenAI 兼容 v1 接口，语义审核 / 视觉审核 / 改写 / TTS 都走这里
BASE_URL1=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR 用原生 api/v1 接口
DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash
# ASR_TIMEOUT_SECONDS=300

# --------------------------- 语义审核 ---------------------------
SEMANTIC_ENABLED=true
SEMANTIC_MODEL=deepseek-v4.1-flash-1017
# 语义接口默认复用 BASE_URL1，需要单独地址时填这里
# SEMANTIC_BASE_URL=
# SEMANTIC_TIMEOUT_SECONDS=90
# SEMANTIC_MAX_TOKENS=6000

# --------------------------- 视觉审核 ---------------------------
VISUAL_ENABLED=true
VISUAL_MODEL=qwen3.8-flash
# 自身品牌，不算品牌混淆；多个用英文逗号分隔
VISUAL_OWN_BRANDS=
# VISUAL_MAX_FRAMES=16
# VISUAL_FRAME_WIDTH=512
# VISUAL_TIMEOUT_SECONDS=120
# VISUAL_MAX_TOKENS=1800
# 视觉事件密集复核（命中后 ±12s、1s 步长重扫，定位更准，每个事件多一次调用）
# VISUAL_RELOCALIZE_ENABLED=true
# VISUAL_RELOCALIZE_RADIUS_MS=12000
# VISUAL_RELOCALIZE_STEP_MS=1000
# VISUAL_RELOCALIZE_MAX_FRAMES=24
# VISUAL_RELOCALIZE_MAX_EVENTS=6

# --------------------------- 文案改写 ---------------------------
REWRITE_ENABLED=true
REWRITE_MODEL=deepseek-v4.1-flash-1017
# REWRITE_TIMEOUT_SECONDS=90
# REWRITE_MAX_TOKENS=4000
# 口播语速口径：估算与文案预算用 5.0 字/秒，5.8 字/秒为硬拒绝阈值
# SPEECH_CHARS_PER_SECOND=5.0
# SPEECH_MAX_CHARS_PER_SECOND=5.8

# --------------------------- 审核意见同步（内网） ---------------------------
# 启动时若距上次同步超过 AUDIT_FEED_SYNC_HOURS 就在后台拉一次，不可达时静默跳过
AUDIT_FEED_ENABLED=true
AUDIT_FEED_BASE_URL=http://192.168.31.76:8011
# AUDIT_FEED_TIMEOUT_SECONDS=20
# AUDIT_FEED_PAGE_SIZE=200
# AUDIT_FEED_MAX_PAGES=30
# AUDIT_FEED_SYNC_HOURS=12
# AUDIT_FEED_PROMPT_CASES=8

# --------------------------- 渲染与路由开关 ---------------------------
# 批量渲染（工作台"生成修改版"）。关闭后 /apply?dry_run=false 直接 409
RENDER_ENABLED=true
BATCH_RENDER_ENABLED=true
# TTS 局部换音：音质不达标，默认关闭，route=tts 一律转人工
TTS_ROUTE_ENABLED=false
# 自动删段：默认关闭，删除类 finding 只进工单，由人在剪映处理
AUTO_CUT_ENABLED=false
# Wan 失败后是否自动回退到局部 TTS，默认关闭（避免产出低质结果）
SHOT_TTS_FALLBACK_ENABLED=false

# --------------------------- TTS ---------------------------
# TTS_PROVIDER=auto          # auto | cosyvoice | edge
# TTS_MODEL=cosyvoice-v3-plus
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE=+0%
# TTS_VOICE_ID=
# TTS_MAX_TEMPO=1.15
# TTS_SAMPLE_RATE=24000
# VOICE_CLONE_ENABLED=true
# VOICE_REFERENCE_PATH=
# VOICE_CACHE_DIR=

# --------------------------- Wan 整镜替换 ---------------------------
# 短镜补齐：只有 ffmpeg scene 分数 <= 该值的切点才允许合并成一个 Wan 单元
# MERGE_SCENE_SCORE_MAX=0.40
# WAN_MERGE_MAX_SECONDS=4.0
# SEGMENT_REPLACE_ENABLED=true
# SEGMENT_PRESERVE_BGM=true
# VOICE_REFERENCE_MIN_MS=16000
# VOICE_REFERENCE_MAX_MS=30000
# VOICE_REFERENCE_TARGET_MS=30000

# --------------------------- Demucs 人声分离 ---------------------------
# Demucs 依赖 torch，不放进主依赖，需要单独准备解释器（默认找 data/tools/demucs-venv）
# DEMUCS_PYTHON=data\tools\demucs-venv\Scripts\python.exe
# DEMUCS_MODEL=htdemucs
# DEMUCS_DEVICE=cuda
# DEMUCS_TIMEOUT_SECONDS=900